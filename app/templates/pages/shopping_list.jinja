{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

  <h2>Shopping List</h2>  

<section id="shopping">

    <div class="list">

        {% for ingredient in ingredients %}
          <div class="ingredient">
              <h4>{{ ingredient["name"] }}</h4>

              <form method="POST" action="/shopping/delete/{{ ingredient['id'] }}">
                  <button type="submit">Remove</button>
              </form>
          </div>
        {% else %}
          <h4>Empty</h4>
        {% endfor %}

    </div>

</section>

{% endblock %}

