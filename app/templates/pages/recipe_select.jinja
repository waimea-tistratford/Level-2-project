{% extends 'pages/_base.jinja' %}

{% block content %}

    <section id="recipes">
        <h1>Choose a Recipe</h1>

        {% for recipe in recipes %}
            <div class="recipe">
                <h2>{{ recipe.name }}</h2>
                <div class="ingredients">
                    {% for ingredient in recipe.ingredients %}
                        <h4>{{ ingredient }}</h4>
                    {% else %}
                        <h4>No ingredients listed</h4>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <p>No recipes found.</p>
        {% endfor %}
    </section>

{% endblock %}