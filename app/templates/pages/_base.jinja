{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Recipe Book {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/book.png">

    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>
        
            Recipe Book

        <nav>
            <a href="/">
                <img src="/static/images/list.png" alt="List Icon" class="link">
            </a>
            <a href="/shopping">
                <img src="/static/images/shopping.png" alt="Shopping Icon" class="link">
            </a>
            
        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

</body>

</html>

